# 1Password references, resolved at launch by `posts` (op run). These are pointers, not secrets.
# Prod keys (your dominant usage). For dev, swap the field: prod -> dev / admin-prod -> admin-dev / deposit_retry_prod -> deposit_retry_dev.
ORCH_API_KEY=op://Shared/relayer orchestrator api key/prod
ORCH_RETRY_KEY=op://Shared/orchestrator api key/deposit_retry_prod
ORCH_ADMIN_KEY=op://Shared/orchestrator admin api key/admin-prod
FAUCET_API_KEY=op://Shared/faucet api key/api_key
